# ============================================================
# LLM-Client 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ============================================================

# ===== API 配置 =====
# LLM API Base URL（兼容 OpenAI API 格式）
LLM_BASE_URL=https://api.openai.com/v1
# API Key
LLM_API_KEY=
# 模型名称（默认 gpt-4o-mini）
LLM_MODEL=gpt-4o-mini

# ===== 高级配置 =====
# 最大 Token 数（默认 4096）
LLM_MAX_TOKENS=4096
# Temperature（0.0 - 2.0，默认 0.7）
LLM_TEMPERATURE=0.7
# 请求超时（秒，默认 60）
LLM_TIMEOUT=60
# 最大重试次数（默认 3）
LLM_MAX_RETRIES=3

# ===== Agent 配置 =====
# Agent 最大迭代次数（默认 20）
AGENT_MAX_ITERATIONS=20
# 工具执行超时（秒，默认 30）
TOOL_TIMEOUT=30
